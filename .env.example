# Local PostgreSQL connection and database settings
DATABASE_URL=PLACEHOLDER_DATABASE_URL
POSTGRES_USER=PLACEHOLDER_POSTGRES_USER
POSTGRES_PASSWORD=PLACEHOLDER_POSTGRES_PASSWORD
POSTGRES_DB=PLACEHOLDER_POSTGRES_DB

# Application URLs and authentication secret placeholder
APP_ENV=development
JWT_SECRET=PLACEHOLDER_REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000
APP_BASE_URL=PLACEHOLDER_APP_BASE_URL
API_BASE_URL=PLACEHOLDER_API_BASE_URL

# Google OAuth client placeholders
GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_CLIENT_SECRET

# Telegram and SMTP notification placeholders
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN
SMTP_HOST=PLACEHOLDER_SMTP_HOST
SMTP_PORT=587
SMTP_USER=PLACEHOLDER_SMTP_USER
SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
SMTP_FROM=PLACEHOLDER_SMTP_FROM
SMTP_STARTTLS=true

# Trust X-Forwarded-For only behind a configured trusted proxy
TRUST_PROXY=false

# Language model provider and API placeholders
LLM_PROVIDER=PLACEHOLDER_LLM_PROVIDER
LLM_API_KEY=PLACEHOLDER_LLM_API_KEY
LLM_BASE_URL=PLACEHOLDER_LLM_BASE_URL
LLM_MODEL=PLACEHOLDER_LLM_MODEL
OLLAMA_BASE_URL=PLACEHOLDER_OLLAMA_BASE_URL
